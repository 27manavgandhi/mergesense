GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
REDIS_URL=
PORT=3000

# Fault Injection (Chaos Safety)
# FAULTS_ENABLED=true
# FAULT_DIFF_EXTRACTION_FAIL=0.1
# FAULT_AI_TIMEOUT=0.2
# FAULT_AI_MALFORMED_RESPONSE=never
# FAULT_REDIS_UNAVAILABLE=never
# FAULT_SEMAPHORE_LEAK_SIMULATION=never
# FAULT_DECISION_WRITE_FAILURE=never
# FAULT_METRICS_WRITE_FAILURE=never
# FAULT_PUBLISH_COMMENT_FAILURE=never

# === MERGE POLICY ENFORCEMENT (DAY 24) ===

# Policy enforcement mode
# OFF (default) - Advisory only, no status checks
# WARN - Non-blocking status check with warnings
# ENFORCE - Blocking status check, prevents merge on violation
MERGESENSE_POLICY_MODE=OFF

# Maximum allowed risk level (LOW | MEDIUM | HIGH | CRITICAL)
# PRs exceeding this level trigger policy violation
# Default: HIGH
MERGESENSE_MAX_RISK_LEVEL=HIGH

# Minimum required verdict confidence (0.0 - 1.0)
# PRs below this confidence trigger policy violation
# Default: 0.60
MERGESENSE_MIN_CONFIDENCE=0.60

# Allow misaligned verdicts (true | false)
# If false, misalignment between AI verdict and risk score triggers violation
# Default: true
MERGESENSE_ALLOW_MISALIGNED=true

# Repo override list (comma-separated)
# Repositories in this list bypass all policy checks
# Format: owner/repo,owner2/repo2
# Example: acme/critical-service,acme/legacy-app
MERGESENSE_REPO_OVERRIDE_LIST=

# Maximum memory usage in MB (process exits if exceeded)
# Default: 512 MB
# Recommended: 512 for single instance, 1024 for high load
MERGESENSE_MAX_MEMORY_MB=512

# Maximum webhook requests per minute
# Default: 60 RPM
# Recommended: Start at 60, increase based on monitoring
MERGESENSE_MAX_RPM=60

# Maximum concurrent PR processing
# Default: 5
# Recommended: 5 for 512MB, 10 for 1GB+
MERGESENSE_MAX_CONCURRENT=5# Maximum memory usage in MB (process exits if exceeded)
# Default: 512 MB
# Recommended: 512 for single instance, 1024 for high load
MERGESENSE_MAX_MEMORY_MB=512

# Maximum webhook requests per minute
# Default: 60 RPM
# Recommended: Start at 60, increase based on monitoring
MERGESENSE_MAX_RPM=60

# Maximum concurrent PR processing
# Default: 5
# Recommended: 5 for 512MB, 10 for 1GB+
MERGESENSE_MAX_CONCURRENT=5